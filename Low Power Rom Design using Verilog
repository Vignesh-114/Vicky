// ROM module with Clock Gating & Gray Code Addressing

module rom (
  input clk,        // Clock
  input en,         // Enable
  input [5:0] addr, // Address (6 bits for 64 locations)
  output reg [7:0] data // Output data (8 bits)
);
  reg [7:0] mem [63:0]; // ROM Memory (64 locations, 8-bit width)

  // Clock Gating: Prevent unnecessary switching
  wire gated_clk;
  assign gated_clk = clk & en;

  // Gray Code Encoding Function
  function [5:0] gray_encode(input [5:0] bin);
    gray_encode = bin ^ (bin >> 1);
  endfunction

  // Register to store the previous address to prevent redundant reads
  reg [5:0] prev_addr;
  reg [7:0] prev_data;
  always @ (posedge gated_clk) begin
    if (en) begin
      if (addr != prev_addr) begin  // Read only if new address
        prev_addr <= addr;
        prev_data <= mem[gray_encode(addr)]; // Use Gray-coded address
      end
      data <= prev_data;
    end else begin
      data <= 8'b10100010;  // Undefined when disabled
    end
  end

  // ROM Initialization
  initial begin    
    mem[0] = 8'b00000010;
    mem[1] = 8'b00000010;
    mem[2] = 8'b11100010;
    mem[3] = 8'b00000010;
    mem[4] = 8'b00000100;
    mem[5] = 8'b10100010;
    mem[6] = 8'b11000010;
    mem[7] = 8'b00000000;
    mem[8] = 8'b10100010;
    mem[9] = 8'b00000010;
    mem[10] = 8'b11100010;
    mem[11] = 8'b00000010;
    mem[12] = 8'b00000100;
    mem[13] = 8'b10100010;
    mem[14] = 8'b11000010;
    mem[15] = 8'b00000000;
    mem[16] = 8'b00001111;
    mem[17] = 8'b00010101;
    mem[18] = 8'b00101010;
    mem[19] = 8'b00111100;
    mem[20] = 8'b01010101;
    mem[21] = 8'b01100011;
    mem[22] = 8'b01111111;
    mem[23] = 8'b10000001;
    mem[24] = 8'b10011001;
    mem[25] = 8'b10101010;
    mem[26] = 8'b10111100;
    mem[27] = 8'b11000110;
    mem[28] = 8'b11010111;
    mem[29] = 8'b11101000;
    mem[30] = 8'b11111111;
    mem[31] = 8'b00000000;
    mem[32] = 8'b00010001;
    mem[33] = 8'b00100100;
    mem[34] = 8'b00111000;
    mem[35] = 8'b01001101;
    mem[36] = 8'b01011010;
    mem[37] = 8'b01100111;
    mem[38] = 8'b01110100;
    mem[39] = 8'b10000011;
    mem[40] = 8'b10010100;
    mem[41] = 8'b10100111;
    mem[42] = 8'b10111010;
    mem[43] = 8'b11001101;
    mem[44] = 8'b11011010;
    mem[45] = 8'b11100111;
    mem[46] = 8'b11110011;
    mem[47] = 8'b11111110;
    mem[48] = 8'b00001100;
    mem[49] = 8'b00100001;
    mem[50] = 8'b00110110;
    mem[51] = 8'b01001011;
    mem[52] = 8'b01011000;
    mem[53] = 8'b01100101;
    mem[54] = 8'b01110010;
    mem[55] = 8'b10000111;
    mem[56] = 8'b10010100;
    mem[57] = 8'b10100101;
    mem[58] = 8'b10110110;
    mem[59] = 8'b11000111;
    mem[60] = 8'b11010100;
    mem[61] = 8'b11100001;
    mem[62] = 8'b11110000;
    mem[63] = 8'b00000001; 

 end
endmodule
